# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── Database ───────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_ms"

# ─── JWT ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="your-super-secret-access-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Bcrypt ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Paystack ───────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Plan codes — create these on your Paystack dashboard first
# Settings > Plans > Create Plan
PAYSTACK_BASIC_MONTHLY_PLAN="PLN_xxxx"
PAYSTACK_BASIC_TERMLY_PLAN="PLN_xxxx"
PAYSTACK_PREMIUM_MONTHLY_PLAN="PLN_xxxx"
PAYSTACK_PREMIUM_TERMLY_PLAN="PLN_xxxx"

# Pricing in Kobo (₦1 = 100 kobo)
PAYSTACK_BASIC_MONTHLY_AMOUNT=1000000      # ₦10,000
PAYSTACK_BASIC_TERMLY_AMOUNT=2700000       # ₦27,000
PAYSTACK_PREMIUM_MONTHLY_AMOUNT=2500000    # ₦25,000
PAYSTACK_PREMIUM_TERMLY_AMOUNT=6750000     # ₦67,500

# ─── Frontend ───────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
